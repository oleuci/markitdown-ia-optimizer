# Copy to secret.env (never commit it). Minimal required: SESSION_SECRET + an LLM endpoint.

# Session signing secret — generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# --- LLM engine (any OpenAI-compatible /v1/chat/completions endpoint) ---
LLM_ENABLED=1
LLM_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key
LLM_TIMEOUT=120
LLM_MAX_INPUT=30000
LLM_MAX_WORKERS=8
# Examples:
#   OVH AI Endpoints : LLM_BASE=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1  LLM_MODEL=Meta-Llama-3_3-70B-Instruct
#   Local Ollama     : LLM_BASE=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY= (leave empty)
#   vLLM / LM Studio : any server exposing /v1/chat/completions

# --- Application ---
APP_TITLE=MarkItDown IA Optimizer
SECURE_COOKIES=1
MAX_UPLOAD_MB=50
CONVERT_TIMEOUT=170
OCR_LANGS=fra+eng
DATA_DIR=/app/data
TIKTOKEN_CACHE_DIR=/app/data/tiktoken

# Trusted reverse-proxy IP(s) for X-Forwarded-For (systemd deployment only)
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: set the first admin password (otherwise a random one is generated
# at first start and written to data/INITIAL_ADMIN_PASSWORD.txt)
# ADMIN_INITIAL_PASSWORD=
